{
  "name": "@hug0x0/mcp-madagascar",
  "version": "0.1.0",
  "description": "MCP server for Madagascar humanitarian, weather, risk, and open-data source discovery.",
  "type": "module",
  "bin": {
    "mcp-madagascar": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "open-data",
    "public-data",
    "madagascar"
  ],
  "author": "Hug0x0",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hug0x0/mcp-madagascar.git"
  },
  "bugs": {
    "url": "https://github.com/Hug0x0/mcp-madagascar/issues"
  },
  "homepage": "https://github.com/Hug0x0/mcp-madagascar#readme",
  "publishConfig": {
    "access": "public"
  }
}
